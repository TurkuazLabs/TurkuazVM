// 📄 Dosya Yolu: /turkuazvm/apps/desktop/src-tauri/tauri.windows.conf.json5
// 📌 Amac: TurkuazVM Windows NSIS dagitim ayarlarini ana Tauri config uzerine uygular
// 📌 Modul - JSON5
// Version: 0.41.5
// Aciklama: Current-user veya system-wide secilebilir NSIS kurulumunu, Turkce/Ingilizce dil secimini ve Turkce MultiUser hook'unu tanimlar; runtime writable state LOCALAPPDATA altinda tutulur
// Bagimli Oldugu Katman: Tool | View | CI/CD
{
  "bundle": {
    "targets": ["nsis"],
    "publisher": "TurkuazLabs",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "TurkuazVM"
      }
    }
  }
}
