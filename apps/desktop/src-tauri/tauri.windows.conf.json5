// 📄 Dosya Yolu: /turkuazvm/apps/desktop/src-tauri/tauri.windows.conf.json5
// 📌 Amac: TurkuazVM Windows NSIS dagitim ayarlarini ana Tauri config uzerine uygular
// 📌 Modul - JSON5
// Version: 0.41.6
// Aciklama: Current-user/system-wide NSIS modlarini ve Turkce/Ingilizce dil secimini korur; v0.41.6 package katmani install kokunu TurkuazLabs/TurkuazVM olarak uretir
// Bagimli Oldugu Katman: Tool | View | CI/CD
{
  "bundle": {
    "targets": ["nsis"],
    "publisher": "TurkuazLabs",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "TurkuazVM"
      }
    }
  }
}
