# 📄 Dosya Yolu: /turkuazvm/deploy/systemd/turkuazvm-engine.service
# 📌 Amac: Linux TurkuazVM Engine icin systemd service unit sablonunu tanimlar
# 📌 Modul - Systemd
# Version: 0.12.4
# Aciklama: Headless Engine'i ayri config environment file ile otomatik restart politikasi altinda calistirir
# Bagimli Oldugu Katman: Tool

[Unit]
Description=TurkuazVM Headless Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turkuazvm
Group=turkuazvm
WorkingDirectory=/opt/turkuazvm
EnvironmentFile=/etc/turkuazvm/engine.env
ExecStart=/opt/turkuazvm/bin/turkuazvm-engine
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/turkuazvm/data /opt/turkuazvm/runtime

[Install]
WantedBy=multi-user.target
