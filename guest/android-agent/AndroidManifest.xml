<!--
# 📄 Dosya Yolu: /turkuazvm/guest/android-agent/AndroidManifest.xml
# 📌 Amac: Turkuaz Input Agent accessibility service ve loopback socket izinlerini tanimlar
# 📌 Modul - XML
# Version: 0.21.0
# Aciklama: Gesture dispatch yetenekli AccessibilityService'i sistem APK'si olarak kaydeder
# Bagimli Oldugu Katman: Service | Config
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.turkuazvm.inputagent"
    android:versionCode="2100"
    android:versionName="0.21.0">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Turkuaz Input Agent"
        android:supportsRtl="false">
        <service
            android:name=".services.TurkuazInputAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
